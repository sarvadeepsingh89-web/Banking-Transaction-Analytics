                "    #\"Added Age Group\" = Table.AddColumn(#\"Changed Type\", \"Age_Group\", each if [Age] <= 25 then \"18-25\" else if [Age] <= 35 then \"26-35\" else if [Age] <= 45 then \"36-45\" else if [Age] <= 55 then \"46-55\" else \"56-70\", type text)",
