          {
            "name": "Average Transaction Value",
            "displayFolder": "Core",
            "expression": "AVERAGE(Fact_Transactions[Amount_INR])",
            "formatString": "₹#,##0.00",
            "lineageTag": "1545ef06-15f4-46f1-826f-3b732adfd088"
          },
          {
            "name": "Successful Transactions",
            "displayFolder": "Status",
            "expression": "CALCULATE(COUNTROWS(Fact_Transactions), Fact_Transactions[Status] = \"Success\")",
            "formatString": "#,##0",
            "lineageTag": "7995d162-e977-4d7b-8214-e7efa86cc493"
          },
          {
            "name": "Failed Transactions",
            "displayFolder": "Status",
            "expression": "CALCULATE(COUNTROWS(Fact_Transactions), Fact_Transactions[Status] = \"Failed\")",
            "formatString": "#,##0",
            "lineageTag": "7cb321d3-224b-4eb5-ace8-1e8e9e96f458"
          },
          {
            "name": "Transaction Success Rate",
            "displayFolder": "Status",
            "expression": "DIVIDE([Successful Transactions], [Total Transactions], 0)",
            "formatString": "0.00%",
            "lineageTag": "825601df-2c24-4dae-9cee-33b6291837d9"
          },
          {
            "name": "Transaction Failure Rate",
            "displayFolder": "Status",
            "expression": "DIVIDE([Failed Transactions], [Total Transactions], 0)",
            "formatString": "0.00%",
            "lineageTag": "b6cade43-396a-429d-97c0-ea523fc104f4"
          },
          {
            "name": "Active Customers",
            "displayFolder": "Customer",
            "expression": "DISTINCTCOUNT(Fact_Transactions[Customer_ID])",
            "formatString": "#,##0",
            "lineageTag": "6c3fb1e7-33b4-48e4-8234-201ecd88e328"
          },
          {
            "name": "Transactions per Customer",
            "displayFolder": "Customer",
            "expression": "DIVIDE([Total Transactions], [Active Customers], 0)",
            "formatString": "0.0",
            "lineageTag": "367bbfe4-8c12-4324-bb59-a75c7d37d3b0"
          },
          {
            "name": "Total Fee Revenue",
            "displayFolder": "Revenue",
            "expression": "SUM(Fact_Transactions[Fee_Revenue_INR])",
            "formatString": "₹#,##0.00",
            "lineageTag": "1c0fd911-9a23-4a3d-a48e-91b27b9787e5"
          },
          {
            "name": "Avg Fee per Transaction",
            "displayFolder": "Revenue",
            "expression": "DIVIDE([Total Fee Revenue], [Total Transactions], 0)",
            "formatString": "₹#,##0.00",
            "lineageTag": "a5e6b70b-1d1e-4923-bd34-1a489e44a840"
          },
          {
            "name": "Previous Month Transactions",
            "displayFolder": "Time Intelligence",
            "expression": "CALCULATE([Total Transactions], DATEADD(Dim_Date[Date], -1, MONTH))",
            "formatString": "#,##0",
            "lineageTag": "b0c3eedd-cf67-4491-baea-da95d401525c"
          },
          {
            "name": "Previous Month Value",
            "displayFolder": "Time Intelligence",
            "expression": "CALCULATE([Total Transaction Value], DATEADD(Dim_Date[Date], -1, MONTH))",
            "formatString": "₹#,##0.00",
            "lineageTag": "89d617e9-caf4-490e-a33b-b914ed42c053"
          },
          {
            "name": "Month-over-Month Transaction Growth",
            "displayFolder": "Time Intelligence",
            "expression": [
              "VAR CurrentMonth = [Total Transactions]",
              "VAR PreviousMonth = CALCULATE([Total Transactions], DATEADD(Dim_Date[Date], -1, MONTH))",
              "RETURN DIVIDE(CurrentMonth - PreviousMonth, PreviousMonth, 0)"
            ],
            "formatString": "0.00%",
            "lineageTag": "43665085-4a84-4e39-a8d1-d1c677e9cc48"
          },
          {
            "name": "Month-over-Month Value Growth",
            "displayFolder": "Time Intelligence",
            "expression": [
              "VAR CurrentVal = [Total Transaction Value]",
              "VAR PrevVal = CALCULATE([Total Transaction Value], DATEADD(Dim_Date[Date], -1, MONTH))",
              "RETURN DIVIDE(CurrentVal - PrevVal, PrevVal, 0)"
            ],
            "formatString": "0.00%",
            "lineageTag": "3362766a-8535-419d-95f6-67cc89b52530"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WMlSKjQUA\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Row_ID = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Row_ID\", Int64.Type}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
